# Copy to backend/.env and fill in. NEVER commit the filled file.
# Local development must never use live payment credentials.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=local

DATABASE_URL=postgres://salon:salon@localhost:5432/salon
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Both spellings: a browser on 127.0.0.1 sends a different Origin than one on
# localhost, and only allowlisting one makes the other fail silently in dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SALON_TIMEZONE=Asia/Kolkata
CAMPAIGN_RESERVATION_TTL_SECONDS=600
LOG_LEVEL=INFO

# Encrypts the daily campaign seed at rest. Required outside DEBUG.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Phase 5. Test-mode keys only in this file.
PAYMENT_GATEWAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 1 seeding only. Min 12 characters.
SEED_OWNER_PASSWORD=

SENTRY_DSN=
